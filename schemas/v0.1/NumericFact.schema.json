      },
      "then": {
        "properties": {
          "normalization": {
            "properties": {
              "status": {
                "const": "DECLARED_FOR_TEST"
              },
              "rule_version": {
                "const": "DECIMAL_LITERAL_IDENTITY_V1"
              }
            }
          }
        }
      }
    }
  ]
