      "minLength": 1
    },
    "normalized_value": {
      "oneOf": [
        {
          "$ref": "urn:aurum-arks:j0a:0.1:common#/$defs/decimal"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
