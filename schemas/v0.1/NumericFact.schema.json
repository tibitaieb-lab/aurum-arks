            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "currency": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "KNOWN"
            },
            "value": {
              "type": "string",
