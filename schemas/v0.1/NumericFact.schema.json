    "schema_version",
    "numeric_fact_id",
    "evidence_id",
    "expression_original",
    "normalized_value",
    "unit",
    "currency",
    "scale",
    "entity",
    "metric",
    "period",
    "revision",
    "normalization"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "normalized_value": {
            "type": "null"
          }
        },
        "required": [
