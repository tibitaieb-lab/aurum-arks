              "enum": [
                "ONE",
                "THOUSAND",
                "MILLION",
                "BILLION"
              ]
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        }
      ]
